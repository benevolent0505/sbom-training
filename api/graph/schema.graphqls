scalar Time

"ブログ記事"
type Post {
  id: ID!
  title: String!
  body: String!
  author: String!
  createdAt: Time!
}

input NewPost {
  title: String!
  body: String!
  author: String!
}

type Query {
  "新しい順の記事一覧"
  posts: [Post!]!
  "ID を指定して記事を取得する。存在しなければ null"
  post(id: ID!): Post
}

type Mutation {
  createPost(input: NewPost!): Post!
}
